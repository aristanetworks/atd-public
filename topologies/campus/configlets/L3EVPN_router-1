spanning-tree mode none
!
vrf instance campus
!
dhcp server
!
  Subnet 10.1.10.0/24
     Default-gateway 10.1.10.1
     Range 10.1.10.10 10.1.10.100
     !
  Subnet 10.1.20.0/24
     Default-gateway 10.1.20.1
     Range 10.1.20.10 10.1.20.100
     !
   Subnet 10.1.30.0/24
     Default-gateway 10.1.30.1
     Range 10.1.30.10 10.1.30.100
     !
   Subnet 10.2.10.0/24
     Default-gateway 10.2.10.1
     Range 10.2.10.10 10.2.10.100
     !
   Subnet 10.2.20.0/24
     Default-gateway 10.2.20.1
     Range 10.2.20.10 10.2.20.100
     !
   Subnet 10.2.30.0/24
     Default-gateway 10.2.30.1
     Range 10.2.30.10 10.2.30.100
     !
   Subnet 10.3.10.0/24
     Default-gateway 10.3.10.1
     Range 10.3.10.10 10.3.10.100
     !
   Subnet 10.3.20.0/24
     Default-gateway 10.3.20.1
     Range 10.3.20.10 10.3.20.100
     !
   Subnet 10.3.30.0/24
     Default-gateway 10.3.30.1
     Range 10.3.30.10 10.3.30.100
     !
   Subnet 10.4.10.0/24
     Default-gateway 10.4.10.1
     Range 10.4.10.10 10.4.10.100
!
interface Ethernet1
   description P2P_LINK_TO_spine-1_Ethernet1
   no shutdown
   mtu 1500
   no switchport
   ip address 10.100.0.0/31
   dhcp server ipv4
!
interface Ethernet2
   description P2P_LINK_TO_spine-2_Ethernet1
   no shutdown
   mtu 1500
   no switchport
   ip address 10.100.0.2/31
   dhcp server ipv4
!
interface Loopback0
   description EVPN_Overlay_Peering
   no shutdown
   ip address 10.255.0.1/32
!
interface Loopback1
   description VTEP_VXLAN_Tunnel_Source
   no shutdown
   ip address 10.255.1.1/32
!
interface Vxlan1
   description router-1_VTEP
   vxlan source-interface Loopback1
   vxlan udp-port 4789
   vxlan vrf campus vni 5001
!
ip routing
ip routing vrf campus
!
ip route vrf campus 0.0.0.0/0 null0
!
router bgp 65000
   router-id 172.16.20.1
   maximum-paths 4 ecmp 4
   no bgp default ipv4-unicast
   neighbor EVPN-OVERLAY-PEERS peer group
   neighbor EVPN-OVERLAY-PEERS update-source Loopback0
   neighbor EVPN-OVERLAY-PEERS bfd
   neighbor EVPN-OVERLAY-PEERS ebgp-multihop 3
   neighbor EVPN-OVERLAY-PEERS send-community
   neighbor EVPN-OVERLAY-PEERS maximum-routes 0
   neighbor IPv4-UNDERLAY-PEERS peer group
   neighbor IPv4-UNDERLAY-PEERS send-community
   neighbor IPv4-UNDERLAY-PEERS maximum-routes 12000
   neighbor 10.100.0.1 peer group IPv4-UNDERLAY-PEERS
   neighbor 10.100.0.1 remote-as 65001
   neighbor 10.100.0.1 description spine-1
   neighbor 10.100.0.3 peer group IPv4-UNDERLAY-PEERS
   neighbor 10.100.0.3 remote-as 65001
   neighbor 10.100.0.3 description spine-2
   neighbor 172.16.1.1 peer group EVPN-OVERLAY-PEERS
   neighbor 172.16.1.1 remote-as 65001
   neighbor 172.16.1.1 description spine-1
   neighbor 172.16.1.2 peer group EVPN-OVERLAY-PEERS
   neighbor 172.16.1.2 remote-as 65001
   neighbor 172.16.1.2 description spine-2
   redistribute connected
   !
   address-family evpn
      neighbor EVPN-OVERLAY-PEERS activate
   !
   address-family ipv4
      neighbor IPv4-UNDERLAY-PEERS activate
   !
   vrf campus
      rd 10.255.0.1:5001
      route-target import evpn 5001:5001
      route-target export evpn 5001:5001
      redistribute static